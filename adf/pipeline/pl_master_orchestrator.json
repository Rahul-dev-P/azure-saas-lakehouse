								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Users/panchalraahul10@gmail.com/azure-saas-lakehouse/databricks/notebooks/silver/02_transform_silver",
								"baseParameters": {
									"p_entity_name": {
										"value": "@item().entity_name",
										"type": "Expression"
									},
									"p_run_mode": {
										"value": "@toLower(pipeline().parameters.p_override_load_type)",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_azure_databricks",
								"type": "LinkedServiceReference"
							}
						}
					]
