									},
									"p_watermark_col": {
										"value": "@item().watermark_column",
										"type": "Expression"
									},
									"p_last_watermark": {
										"value": "@item().last_processed_watermark",
										"type": "Expression"
									},
									"p_target_subpath": {
										"value": "@item().target_subpath",
										"type": "Expression"
									},
									"p_load_type": {
										"value": "@toLower(pipeline().parameters.p_override_load_type)",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "nb_transform_silver",
							"type": "DatabricksNotebook",
