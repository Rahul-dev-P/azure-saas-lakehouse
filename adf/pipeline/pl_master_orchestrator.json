{
	"name": "pl_master_orchestrator",
	"properties": {
		"activities": [
			{
				"name": "lookup_get_active_configs",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT \n    c.source_id,\n    c.source_system,\n    c.entity_name,\n    c.source_type,\n    c.source_schema_or_path,\n    c.source_object_name,\n    c.watermark_column,\n    c.target_container,\n    c.target_subpath,\n    c.silver_table_name,\n    c.gold_table_name,\n    c.load_type,\n    c.execution_order,\n    ISNULL(CONVERT(VARCHAR(23), w.last_processed_watermark, 126), '1970-01-01T00:00:00') AS last_processed_watermark\nFROM etl_control.pipeline_config c\nJOIN etl_control.watermark_control w ON c.source_id = w.source_id\nWHERE c.is_active = 1\nORDER BY c.execution_order ASC, c.source_id ASC;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_generic",
						"type": "DatasetReference",
						"parameters": {
							"p_schema_name": {
								"value": "@string('')",
								"type": "Expression"
							},
							"p_table_name": {
								"value": "@string('')",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "forEach_iterate_entities",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "lookup_get_active_configs",
