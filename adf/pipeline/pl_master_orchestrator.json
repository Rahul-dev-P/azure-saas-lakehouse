							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_ingest_source_to_bronze",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_source_id": {
										"value": "@item().source_id",
										"type": "Expression"
									},
									"p_source_system": {
										"value": "@item().source_system",
										"type": "Expression"
									},
									"p_entity_name": {
										"value": "@item().entity_name",
										"type": "Expression"
									},
									"p_source_type": {
